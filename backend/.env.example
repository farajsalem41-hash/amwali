# Amwali Backend Environment
PORT=5000
NODE_ENV=development

# MongoDB
MONGODB_URI=mongodb://127.0.0.1:27017/amwali

# JWT — generate with: openssl rand -hex 48
JWT_SECRET=CHANGE_ME_GENERATE_A_LONG_RANDOM_SECRET
JWT_EXPIRES_IN=2h
JWT_REFRESH_SECRET=CHANGE_ME_ANOTHER_LONG_RANDOM_SECRET
JWT_REFRESH_EXPIRES_IN=30d

# Public app base URL (used for payment links / QR)
PUBLIC_APP_URL=http://localhost:5173

# CORS (comma separated, * for all)
CORS_ORIGINS=*

# Uploads
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=5

# OTP
OTP_TTL_MINUTES=10
OTP_MAX_ATTEMPTS=5
# In development OTP is returned in the API response. NEVER enable in production.
OTP_DEV_MODE=true

# SMS provider (future) — do not commit real keys
SMS_PROVIDER=
SMS_API_KEY=

# Seed admin (used by npm run seed)
SEED_ADMIN_PHONE=0910000000
SEED_ADMIN_PASSWORD=CHANGE_ME
